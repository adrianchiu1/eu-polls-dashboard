{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config/sources.yaml",
  "type": "object",
  "required": ["schema_version", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["contest_id", "adapter", "locator", "selector", "priority", "verified"],
        "additionalProperties": false,
        "properties": {
          "contest_id": { "type": "string", "pattern": "^[a-z]{2}-(pres|parl|sub)-[a-z0-9-]+$" },
          "adapter": { "enum": ["wikipedia", "dawum", "swedishpolls"] },
          "locator": { "type": "string", "minLength": 1 },
          "selector": { "type": "string", "minLength": 1 },
          "column_map": { "type": "object", "additionalProperties": { "type": "string" } },
          "priority": { "type": "integer", "minimum": 1 },
          "verified": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
